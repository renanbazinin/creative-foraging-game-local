# Static hosting base path (must end with / when using a subpath, e.g. GitHub Pages project sites).
# Examples:
#   VITE_BASE_URL=/creative-foraging-game-local/
#   VITE_BASE_URL=/my-repo-name/
# Root hosting:
#   VITE_BASE_URL=/
#
VITE_BASE_URL=/creative-foraging-game-local/

# Optional: override PWA manifest id (defaults to VITE_BASE_URL).
# VITE_PWA_MANIFEST_ID=/creative-foraging-game-local/

# Hide Admin / Detector2 / reopen-detector shortcuts during live data collection (hash URLs still work).
# VITE_KIOSK_MODE=true

# UI strings locale (add src/locales/<code>.json and wire in src/locales/index.js).
# VITE_LOCALE=en
